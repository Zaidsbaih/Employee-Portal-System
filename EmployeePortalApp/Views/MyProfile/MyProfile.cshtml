@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}
@model EmployeeModel
<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">My Profile</h2>
        <p class="text-muted mb-0">
            View your personal and employment information.
        </p>
    </div>

    <div class="row g-4">

        <!-- Left Profile Card -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <!-- Profile Image -->
                    <div class="rounded-circle bg-warning
                        d-flex justify-content-center
                        align-items-center mx-auto mb-3"
                         style="width: 145px; height: 145px;">

                        <i class="bi bi-person-fill"
                           style="font-size: 70px;"></i>

                    </div>

                    <!-- Employee Name -->
                    <h3 class="fw-bold mb-1">
                        @Model.FullName
                    </h3>

                    <!-- Job Title -->
                    <p class="text-muted mb-3">
                        @Model.JobTitleName
                    </p>

                    <!-- Department -->
                    <span class="badge bg-light text-dark border px-3 py-2 mb-3">
                        @Model.DepartmentName
                    </span>

                    <!-- Status -->
                    <div class="mt-3">

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success px-3 py-2">
                                    Active Account
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    Inactive Account
                                </span>
                            }
                        

                    </div>

                    <hr class="my-4" />

                    <!-- Quick Contact -->
                    <div class="text-start">

                        <div class="d-flex align-items-center mb-3">

                            <div class="rounded-circle bg-light
                                d-flex justify-content-center
                                align-items-center me-3"
                                 style="width: 42px; height: 42px;">

                                <i class="bi bi-envelope-fill"></i>

                            </div>

                            <div>
                                <small class="text-muted d-block">
                                    Email
                                </small>

                                <span>
                                    @Model.Email
                                </span>
                            </div>

                        </div>

                        <div class="d-flex align-items-center">

                            <div class="rounded-circle bg-light
                                d-flex justify-content-center
                                align-items-center me-3"
                                 style="width: 42px; height: 42px;">

                                <i class="bi bi-telephone-fill"></i>

                            </div>

                            <div>
                                <small class="text-muted d-block">
                                    Phone
                                </small>

                                <span>
                                    @Model.Phone
                                </span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Right Information Section -->
        <div class="col-lg-8">

            <!-- Personal Information -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 p-4 pb-0">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-warning
                            d-flex justify-content-center
                            align-items-center me-3"
                             style="width: 52px; height: 52px;">

                            <i class="bi bi-person-vcard-fill fs-4"></i>

                        </div>

                        <div>
                            <h5 class="mb-1">
                                Personal Information
                            </h5>

                            <small class="text-muted">
                                Basic employee details
                            </small>
                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                       

                        <div class="col-md-6">
                            <label class="text-muted small mb-2">
                                Employee ID
                            </label>

                            <input asp-for="Id"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Full Name
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-person me-2"></i>
                                @Model.FullName
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Email Address
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-envelope me-2"></i>
                                @Model.Email
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Phone Number
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-telephone me-2"></i>
                                @Model.Phone
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Birth Date
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-calendar-event me-2"></i>
                                @Model.BirthDate?.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Employment Information -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4 pb-0">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-warning
                            d-flex justify-content-center
                            align-items-center me-3"
                             style="width: 52px; height: 52px;">

                            <i class="bi bi-briefcase-fill fs-4"></i>

                        </div>

                        <div>
                            <h5 class="mb-1">
                                Employment Information
                            </h5>

                            <small class="text-muted">
                                Job and company details
                            </small>
                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Department
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-building me-2"></i>
                                @Model.DepartmentName
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Job Title
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-briefcase me-2"></i>
                                @Model.JobTitleName
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Manager
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-person-badge me-2"></i>
                                @Model.ManagerName
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted small mb-2">
                                Joining Date
                            </label>

                            <div class="border rounded p-3 bg-light">
                                <i class="bi bi-calendar-check me-2"></i>
                                @Model.JoiningDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>