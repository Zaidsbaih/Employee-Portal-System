@model List<PolicyModel>

@{
    ViewData["Title"] = "Policies";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Company Policies
        </h2>

        <p class="text-muted mb-0">
            View and download company policies.
        </p>
    </div>


    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <form asp-controller="Policy"
                  asp-action="Policies"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-8">

                        <label class="form-label">
                            Search by Policy Title
                        </label>

                        <input type="text"
                               name="title"
                               class="form-control"
                               placeholder="Enter policy title" />

                    </div>

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-dark me-2">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                        <a asp-controller="Policy"
                           asp-action="Policies"
                           class="btn btn-outline-secondary">

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Policies -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4 pb-0">

            <h5 class="mb-1">
                Available Policies
            </h5>

            <small class="text-muted">
                Active company policies available to employees.
            </small>

        </div>

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Upload Date</th>
                            <th>Document</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    No policies found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (PolicyModel policy in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @policy.Title
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @policy.Category
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(policy.Description)
                                            ? "-"
                                            : policy.Description)
                                    </td>

                                    <td>
                                        @policy.UploadDate.ToString("dd MMMM yyyy")
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(policy.FilePath))
                                        {
                                            <a href="~/policies/@policy.FilePath"
                                               target="_blank"
                                               class="btn btn-outline-primary btn-sm">

                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                                View PDF

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No File
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>