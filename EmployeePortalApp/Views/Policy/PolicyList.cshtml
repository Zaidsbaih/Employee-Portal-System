@model List<PolicyModel>

@{
    ViewData["Title"] = "Policies List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Policies
            </h2>

            <p class="text-muted mb-0">
                Manage company policies and documents.
            </p>
        </div>

        <a asp-controller="Policy"
           asp-action="NewPolicy"
           class="btn btn-dark">

            <i class="bi bi-plus-circle me-1"></i>
            Add Policy

        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Upload Date</th>
                            <th>Status</th>
                            <th>PDF</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    No policies found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (PolicyModel policy in Model)
                            {
                                <tr>

                                    <td>
                                        @policy.Title
                                    </td>

                                    <td>
                                        @policy.Category
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(policy.Description)
                                            ? "-"
                                            : policy.Description)
                                    </td>

                                    <td>
                                        @policy.UploadDate.ToString("dd MMMM yyyy")
                                    </td>

                                    <td>

                                        @if (policy.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(policy.FilePath))
                                        {
                                            <a href="~/policies/@policy.FilePath"
                                               target="_blank"
                                               class="btn btn-outline-primary btn-sm">

                                                <i class="bi bi-file-earmark-pdf"></i>
                                                View PDF

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No File
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Policy"
                                           asp-action="EditPolicy"
                                           asp-route-id="@policy.Id"
                                           class="btn btn-warning btn-sm me-1">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit

                                        </a>


                                        <a asp-controller="Policy"
                                           asp-action="DeletePolicy"
                                           asp-route-id="@policy.Id"
                                           class="btn btn-danger btn-sm">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>