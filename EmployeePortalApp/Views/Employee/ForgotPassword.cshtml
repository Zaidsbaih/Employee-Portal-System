@{
}
@model ForgotPasswordModel
<!doctype html>
<head>
    <title>
       Forgot Your Password
    </title>

</head>
<body>

    <div class="container vh-100 d-flex justify-content-center align-items-center">

        <div class="card shadow p-4" style="width: 700px;">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">
                Reset Your Password    
                </h3>
                <form asp-action= "ForgotPassword" asp-controller="Employee" method="post" >
                    <div class="mb-3">
                        <label for="exampleFormControlInput1" class="form-label">Your Email</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com">
                    </div>

                    <div class="text-center mt-4">
                        <input type="submit" value="Send The OTP" class="btn btn-primary px-5"  />
                    </div>
                </form>
            </div>
        </div>

    </div>
</body>
</html>