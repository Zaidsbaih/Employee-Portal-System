@model DashboardModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}
@if (TempData["AttendanceError"] != null)
{
    <div class="alert alert-danger">
        @TempData["AttendanceError"]
    </div>
}

@if (TempData["AttendanceSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["AttendanceSuccess"]
    </div>
}

<div class="container-fluid">

    <!-- Welcome Section -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="fw-bold mb-2">
                        Welcome, @Model.EmployeeName 👋
                    </h2>

                    <p class="text-muted mb-3">
                        Here is your work summary for today.
                    </p>

                    <div class="d-flex flex-wrap gap-3">

                        <span class="badge bg-light text-dark border px-3 py-2">
                            Department:
                            @(string.IsNullOrWhiteSpace(Model.DepartmentName)
                                ? "-"
                                : Model.DepartmentName)
                        </span>

                        <span class="badge bg-light text-dark border px-3 py-2">
                            Job Title:
                            @(string.IsNullOrWhiteSpace(Model.JobTitleName)
                                ? "-"
                                : Model.JobTitleName)
                        </span>

                    </div>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                    {
                        <img src="~/images/@Model.PhotoPath"
                             alt="@Model.EmployeeName"
                             class="rounded-circle border shadow-sm"
                             style="width: 90px; height: 90px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-warning
                            d-inline-flex justify-content-center align-items-center"
                             style="width: 90px; height: 90px;">

                            <i class="bi bi-person-fill fs-1"></i>

                        </div>
                    }

                    <div class="mt-2">

                        <strong>
                            @DateTime.Now.ToString("dddd")
                        </strong>

                        <div class="text-muted">
                            @DateTime.Now.ToString("dd MMMM yyyy")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Attendance and Holidays -->
    <div class="row g-4">

        <!-- Today's Attendance -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-warning
                            d-flex justify-content-center align-items-center me-3"
                             style="width: 55px; height: 55px;">

                            <i class="bi bi-clock-fill fs-4"></i>

                        </div>

                        <div>
                            <h5 class="mb-1">
                                Today's Attendance
                            </h5>

                            <small class="text-muted">
                                Your attendance status for today
                            </small>
                        </div>

                    </div>


                    @if (Model.TodayAttendance == null)
                    {
                        <div class="alert alert-secondary">

                            <div class="d-flex justify-content-between align-items-center">

                                <span class="fw-semibold">
                                    Current Status
                                </span>

                                <span class="badge bg-secondary">
                                    Not Clocked In
                                </span>

                            </div>

                        </div>

                        <div class="row text-center py-3">

                            <div class="col-6 border-end">
                                <small class="text-muted d-block">
                                    Clock In
                                </small>

                                <strong>--:--</strong>
                            </div>

                            <div class="col-6">
                                <small class="text-muted d-block">
                                    Clock Out
                                </small>

                                <strong>--:--</strong>
                            </div>

                        </div>

                        <div class="d-grid mt-3">

                            <form asp-controller="Attendance"
                                  asp-action="ClockIn"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-success w-100">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Clock In

                                </button>

                            </form>

                        </div>
                    }
                    else if (Model.TodayAttendance.ClockOut == null)
                    {
                        <div class="alert alert-success">

                            <div class="d-flex justify-content-between align-items-center">

                                <span class="fw-semibold">
                                    Current Status
                                </span>

                                <span class="badge bg-success">
                                    Clocked In
                                </span>

                            </div>

                        </div>

                        <div class="row text-center py-3">

                            <div class="col-6 border-end">

                                <small class="text-muted d-block">
                                    Clock In
                                </small>

                                <strong>
                                    @Model.TodayAttendance.ClockIn.ToString("hh:mm tt")
                                </strong>

                            </div>

                            <div class="col-6">

                                <small class="text-muted d-block">
                                    Clock Out
                                </small>

                                <strong>--:--</strong>

                            </div>

                        </div>

                        <div class="d-grid mt-3">

                            <form asp-controller="Attendance"
                                  asp-action="ClockOut"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger w-100">

                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Clock Out

                                </button>

                            </form>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-primary">

                            <div class="d-flex justify-content-between align-items-center">

                                <span class="fw-semibold">
                                    Current Status
                                </span>

                                <span class="badge bg-primary">
                                    Completed
                                </span>

                            </div>

                        </div>

                        <div class="row text-center py-3">

                            <div class="col-4 border-end">

                                <small class="text-muted d-block">
                                    Clock In
                                </small>

                                <strong>
                                    @Model.TodayAttendance.ClockIn.ToString("hh:mm tt")
                                </strong>

                            </div>

                            <div class="col-4 border-end">

                                <small class="text-muted d-block">
                                    Clock Out
                                </small>

                                <strong>
                                    @Model.TodayAttendance.ClockOut.Value.ToString("hh:mm tt")
                                </strong>

                            </div>

                            <div class="col-4">

                                <small class="text-muted d-block">
                                    Working Hours
                                </small>

                                @if (Model.TodayAttendance.WorkingHours.HasValue)
                                {
                                    <strong>
                                        @Model.TodayAttendance.WorkingHours.Value.Hours h
                                        @Model.TodayAttendance.WorkingHours.Value.Minutes m
                                    </strong>
                                }
                                else
                                {
                                    <strong>-</strong>
                                }

                            </div>

                        </div>
                    }


                    <div class="d-grid mt-3">

                        <a asp-controller="Attendance"
                           asp-action="AttendanceHistory"
                           class="btn btn-outline-dark">

                            View Attendance History

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Upcoming Holidays -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-warning
                            d-flex justify-content-center align-items-center me-3"
                             style="width: 55px; height: 55px;">

                            <i class="bi bi-calendar-event-fill fs-4"></i>

                        </div>

                        <div>
                            <h5 class="mb-1">
                                Upcoming Holidays
                            </h5>

                            <small class="text-muted">
                                The nearest active company holidays
                            </small>
                        </div>

                    </div>


                    @if (Model.UpcomingHolidays == null ||
                         Model.UpcomingHolidays.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            No upcoming holidays.
                        </div>
                    }
                    else
                    {
                        @foreach (HolidayModel holiday in Model.UpcomingHolidays)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <h6 class="mb-1">
                                            @holiday.Name
                                        </h6>

                                        <small class="text-muted">

                                            @if (string.IsNullOrWhiteSpace(holiday.Description))
                                            {
                                                <span>Company Holiday</span>
                                            }
                                            else
                                            {
                                                @holiday.Description
                                            }

                                        </small>

                                    </div>

                                    <div class="text-end">

                                        <span class="badge bg-warning text-dark mb-1">

                                            @holiday.StartDate.ToString("dd MMM yyyy")

                                        </span>

                                        @if (holiday.EndDate.Date != holiday.StartDate.Date)
                                        {
                                            <small class="text-muted d-block">
                                                Until
                                                @holiday.EndDate.ToString("dd MMM yyyy")
                                            </small>
                                        }

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Today's Birthdays -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-4">

                <div class="rounded-circle bg-warning
                    d-flex justify-content-center align-items-center me-3"
                     style="width: 55px; height: 55px;">

                    <i class="bi bi-gift-fill fs-4"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        Today's Birthdays
                    </h5>

                    <small class="text-muted">
                        Employees celebrating their birthday today
                    </small>

                </div>

            </div>


            @if (Model.TodayBirthdays == null ||
                 Model.TodayBirthdays.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No employee birthdays today.
                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (EmployeeModel employee in Model.TodayBirthdays)
                    {
                        <div class="col-md-6 col-xl-4">

                            <div class="border rounded p-3
                                d-flex align-items-center h-100">

                                @if (!string.IsNullOrWhiteSpace(employee.PhotoPath))
                                {
                                    <img src="~/images/@employee.PhotoPath"
                                         alt="@employee.FullName"
                                         class="rounded-circle me-3"
                                         style="width: 55px;
                                    height: 55px;
                                    object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-dark text-white
                                        d-flex justify-content-center
                                        align-items-center me-3"
                                         style="width: 55px; height: 55px;">

                                        <i class="bi bi-person-fill fs-4"></i>

                                    </div>
                                }

                                <div>

                                    <h6 class="mb-1">
                                        @employee.FullName
                                    </h6>

                                    <small class="text-muted d-block">
                                        @(string.IsNullOrWhiteSpace(employee.JobTitleName)
                                            ? "-"
                                            : employee.JobTitleName)
                                    </small>

                                    <small class="text-muted">
                                        @(string.IsNullOrWhiteSpace(employee.DepartmentName)
                                            ? "-"
                                            : employee.DepartmentName)
                                    </small>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>