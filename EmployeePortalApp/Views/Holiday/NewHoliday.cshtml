@model HolidayModel

@{
    ViewData["Title"] = "New Holiday";

    bool isEdit = ViewBag.IsEdit == true;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>

    <div class="container min-vh-100 d-flex justify-content-center align-items-center py-4">

        <div class="card shadow border-0 p-4"
             style="width: 700px;">

            <div class="card-body">

                <h3 class="card-title text-center mb-4">
                    @(isEdit ? "Update Holiday" : "Create New Holiday")
                </h3>

                <form asp-controller="Holiday" method="post">

                    <input type="hidden" asp-for="Id" />

                    <!-- Holiday Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            Holiday Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter holiday name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <!-- Start Date and End Date -->
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label">
                                Start Date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label">
                                End Date
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter holiday description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <!-- Is Active -->
                    <div class="form-check form-switch mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active Holiday
                        </label>

                    </div>

                    <!-- Submit Button -->
                    <div class="text-center mt-4">

                        @if (!isEdit)
                        {
                            <button type="submit"
                                    asp-action="SaveHoliday"
                                    class="btn btn-primary px-5">

                                Save Holiday

                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    asp-action="UpdateHoliday"
                                    class="btn btn-primary px-5">

                                Update Holiday

                            </button>
                        }

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>