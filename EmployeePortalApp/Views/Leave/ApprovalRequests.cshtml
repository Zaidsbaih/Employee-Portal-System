@model ApprovalRequestsVM

@{
    ViewData["Title"] = "Approval Requests";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}
<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Approval Requests
        </h2>
        <p class="text-muted mb-0">
            Review and manage leave requests from your employees.
        </p>
    </div>
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="mb-3">
                Filter Requests
            </h5>
            <form asp-controller="Leave"
                  asp-action="ApprovalRequests"
                  method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-3">

                        <label class="form-label">
                            Employee Name
                        </label>

                        <input asp-for="EmployeeName"
                               class="form-control"
                               placeholder="Search employee" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="">All Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Cancelled">Cancelled</option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            From Date
                        </label>

                        <input asp-for="FromDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            To Date
                        </label>

                        <input asp-for="ToDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-dark w-100">

                            <i class="bi bi-funnel-fill me-1"></i>
                            Filter

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4 pb-0">

            <div>
                <h5 class="mb-1">
                    Employee Leave Requests
                </h5>

                <small class="text-muted">
                    Requests submitted by employees assigned to you.
                </small>
            </div>

        </div>

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Manager Comment</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Requests.Count == 0)
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    No leave requests found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (LeaveRequestModel leave in Model.Requests)
                            {
                                <tr>

                                    <td>
                                        @leave.EmployeeName
                                    </td>

                                    <td>
                                        @leave.LeaveType
                                    </td>

                                    <td>
                                        @leave.StartDate.ToString("dd MMMM yyyy")
                                    </td>

                                    <td>
                                        @leave.EndDate.ToString("dd MMMM yyyy")
                                    </td>

                                    <td>
                                        @leave.Reason
                                    </td>

                                    <td>

                                        @if (leave.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (leave.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (leave.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @leave.Status
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(leave.ManagerComment)
                                            ? "-"
                                            : leave.ManagerComment)
                                    </td>

                                    <td style="min-width: 300px;">

                                        @if (leave.Status == "Pending")
                                        {
                                            <form asp-controller="Leave"
                                                  method="post">

                                                <input type="hidden"
                                                       name="leaveId"
                                                       value="@leave.Id" />

                                                <div class="mb-2">

                                                    <input type="text"
                                                           name="comment"
                                                           class="form-control form-control-sm"
                                                           placeholder="Manager comment" />

                                                </div>

                                                <button type="submit"
                                                        asp-action="Approve"
                                                        class="btn btn-success btn-sm me-1">

                                                    <i class="bi bi-check-lg"></i>
                                                    Approve

                                                </button>

                                                <button type="submit"
                                                        asp-action="Reject"
                                                        class="btn btn-danger btn-sm">

                                                    <i class="bi bi-x-lg"></i>
                                                    Reject

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Decision Made
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>