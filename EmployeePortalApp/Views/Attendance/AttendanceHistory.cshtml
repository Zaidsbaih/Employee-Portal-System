@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}
@model AttendanceHistoryVM
<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Attendance
            </h2>

            <p class="text-muted mb-0">
                Record and review your working hours.
            </p>
        </div>

        <div class="text-end">
            <h6 class="mb-1">
                @DateTime.Now.ToString("dddd")
            </h6>

            <small class="text-muted">
                @DateTime.Now.ToString("dd MMMM yyyy")
            </small>
        </div>

    </div>


    <!-- Messages -->
    @if (TempData["AttendanceSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["AttendanceSuccess"]
        </div>
    }

    @if (TempData["AttendanceError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["AttendanceError"]
        </div>
    }


    <!-- Today's Attendance -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-4">

                <div class="rounded-circle bg-warning
                    d-flex justify-content-center
                    align-items-center me-3"
                     style="width: 55px; height: 55px;">

                    <i class="bi bi-clock-fill fs-4"></i>

                </div>

                <div>
                    <h5 class="mb-1">
                        Today's Attendance
                    </h5>

                    <small class="text-muted">
                        Record your working hours for today
                    </small>
                </div>

            </div>


            <div class="row g-4 align-items-stretch">

                <!-- Status -->
                <div class="col-lg-4">

                    <div class="border rounded p-4 h-100 text-center">

                        <small class="text-muted d-block mb-2">
                            Current Status
                        </small>

                        @if (Model.TodayAttendance == null)
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                Not Clocked In
                            </span>
                        }
                        else if (Model.TodayAttendance.ClockOut == null)
                        {
                            <span class="badge bg-success px-3 py-2">
                                Clocked In
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary px-3 py-2">
                                Completed
                            </span>
                        }

                    </div>

                </div>


                <!-- Clock In -->
                <div class="col-lg-4">

                    <div class="border rounded p-4 h-100 text-center">

                        <small class="text-muted d-block mb-2">
                            Clock In
                        </small>

                        <h4 class="fw-bold mb-3">
                            @(Model.TodayAttendance == null
                                ? "--:--"
                                : Model.TodayAttendance.ClockIn.ToString("hh:mm tt"))
                        </h4>

                        <form asp-controller="Attendance"
                              asp-action="ClockIn"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Clock In

                            </button>

                        </form>

                    </div>

                </div>


                <!-- Clock Out -->
                <div class="col-lg-4">

                    <div class="border rounded p-4 h-100 text-center">

                        <small class="text-muted d-block mb-2">
                            Clock Out
                        </small>

                        <h4 class="fw-bold mb-3">
                            @(Model.TodayAttendance?.ClockOut == null
                                ? "--:--"
                                : Model.TodayAttendance.ClockOut.Value.ToString("hh:mm tt"))
                        </h4>

                        <form asp-controller="Attendance"
                              asp-action="ClockOut"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger w-100">

                                <i class="bi bi-box-arrow-right me-1"></i>
                                Clock Out

                            </button>

                        </form>

                    </div>

                </div>

            </div>


            <!-- Working Hours -->
            <div class="bg-light border rounded p-3 mt-4">

                <div class="d-flex justify-content-between align-items-center">

                    <span class="fw-semibold">
                        Working Hours Today
                    </span>

                    <span class="fw-bold">
                        @if (Model.TodayAttendance?.WorkingHours != null)
                        {
                            <span>
                                @Model.TodayAttendance.WorkingHours.Value.Hours h
                                @Model.TodayAttendance.WorkingHours.Value.Minutes m
                            </span>
                        }
                        else
                        {
                            <span>0 h 0 m</span>
                        }
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Attendance History -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4 pb-0">

            <div class="d-flex align-items-center">

                <div class="rounded-circle bg-warning
                    d-flex justify-content-center
                    align-items-center me-3"
                     style="width: 52px; height: 52px;">

                    <i class="bi bi-calendar-check-fill fs-4"></i>

                </div>

                <div>
                    <h5 class="mb-1">
                        Attendance History
                    </h5>

                    <small class="text-muted">
                        Review your previous attendance records
                    </small>
                </div>

            </div>

        </div>

        <div class="card-body p-4">


            <!-- Filter by Date -->
            <form asp-controller="Attendance"
                  asp-action="AttendanceHistory"
                  method="get"
                  class="mb-4">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label">
                            From Date
                        </label>

                        <input asp-for="FromDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            To Date
                        </label>

                        <input asp-for="ToDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-dark me-2">

                            <i class="bi bi-funnel-fill me-1"></i>
                            Filter

                        </button>

                        <a asp-controller="Attendance"
                           asp-action="AttendanceHistory"
                           class="btn btn-outline-secondary">

                            Clear

                        </a>

                    </div>

                </div>

            </form>


            <!-- Attendance Table -->
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Working Hours</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        <!-- Temporary UI Data -->
                        @if (Model.AttendanceList == null || Model.AttendanceList.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No attendance records were found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (AttendanceModel item in Model.AttendanceList)
                            {
                                <tr>
                                    <td>
                                        @item.ClockIn.ToString("dd MMMM yyyy")
                                    </td>

                                    <td>
                                        @item.ClockIn.ToString("hh:mm tt")
                                    </td>

                                    <td>
                                        @(item.ClockOut.HasValue
                                            ? item.ClockOut.Value.ToString("hh:mm tt")
                                            : "--:--")
                                    </td>

                                    <td>
                                        @if (item.WorkingHours.HasValue)
                                        {
                                            <span>
                                                @item.WorkingHours.Value.Hours h
                                                @item.WorkingHours.Value.Minutes m
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Not calculated</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.ClockOut.HasValue)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Open
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            <!-- Empty State Example -->
            @*
            <div class="alert alert-info text-center mb-0">
                No attendance records were found.
            </div>
            *@

        </div>

    </div>

</div>